<section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-inner">
        <div class="hero-copy">
            <p class="hero-eyebrow">
                <span class="pulse-dot" aria-hidden="true"></span>
                Now in beta
            </p>
            <h1 id="hero-title" class="hero-title display">Finally heard. <span class="hero-accent">Finally resolved.</span></h1>
            <p class="hero-sub">
                Document what happens at work with tamper-evident timestamps, keep your evidence private on your own device, and
                turn it into a clear, HR-ready complaint when you are ready.
            </p>
            <div class="hero-ctas">
                <a href="{{site.appUrl}}" class="btn" data-variant="primary" data-size="lg">
                    Start documenting, free {{{icon "arrow-right" "size-4"}}}
                </a>
                <a href="#how-it-works" class="btn" data-size="lg">See how it works</a>
            </div>
            <ul class="hero-trust">
                <li>{{{icon "shield-check" "size-4"}}} Encrypted on device</li>
                <li>{{{icon "wifi-off" "size-4"}}} Works offline</li>
                <li>{{{icon "smartphone" "size-4"}}} Installable</li>
                <li>{{{icon "scale" "size-4"}}} Not legal advice</li>
            </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="hero-stage" data-tilt>
                <div class="device">
                    <div class="device-notch"></div>
                    {{> device-dashboard}}
                </div>
                <div class="float-card" data-float="1">
                    <span class="float-icon">{{{icon "lock-keyhole" "size-4"}}}</span>
                    <span><span class="mono">INC-014</span> logged · 09:42</span>
                </div>
                <div class="float-card" data-float="2">
                    <span class="float-icon" data-tone="pattern">{{{icon "chart-spline" "size-4"}}}</span>
                    <span>Pattern found: 4 incidents, same person</span>
                </div>
            </div>
        </div>
    </div>
</section>
