<section class="section founder" aria-labelledby="founder-title">
    <h2 id="founder-title" class="sr-only">Why Resolvr exists</h2>
    <figure class="founder-card" data-reveal>
        <span class="icon-badge" data-size="lg">{{{icon "quote" "size-5"}}}</span>
        <blockquote>{{founderQuote.text}}</blockquote>
        <figcaption>
            {{!-- Replace the initials with a photo of Ayodapo Ige when available. --}}
            <span class="founder-avatar" aria-hidden="true">AI</span>
            <span><strong>{{founderQuote.name}}</strong><br /><span class="muted">{{founderQuote.role}}</span></span>
        </figcaption>
    </figure>
</section>
