<section class="section problem" aria-labelledby="problem-title">
    <div class="section-head">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title" class="section-title">When something goes wrong at work, <span class="muted">you're on your own.</span></h2>
    </div>
    <ul class="icon-cards" data-cols="3" data-stagger>
        {{#each problems}}
        <li class="icon-card">
            <span class="icon-badge" data-tone="warn">{{{icon icon "size-5"}}}</span>
            <h3>{{title}}</h3>
            <p>{{body}}</p>
        </li>
        {{/each}}
    </ul>
    <figure class="problem-stat" data-reveal>
        <p class="problem-stat-figure">{{problemStat.figure}}</p>
        <figcaption>
            <p>{{problemStat.text}}</p>
            <a href="{{problemStat.url}}" class="problem-stat-source" target="_blank" rel="noopener noreferrer">
                Source: {{problemStat.source}} {{{icon "arrow-up-right" "size-3.5"}}}
            </a>
        </figcaption>
    </figure>
</section>
