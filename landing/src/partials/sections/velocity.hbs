<div class="velocity" data-velocity aria-hidden="true">
    <div class="velocity-row" data-velocity-row="1">
        {{#each velocityWords.top}}<span>{{this}}</span><i>{{{icon "sparkle" "size-6"}}}</i>{{/each}}
        {{#each velocityWords.top}}<span>{{this}}</span><i>{{{icon "sparkle" "size-6"}}}</i>{{/each}}
    </div>
    <div class="velocity-row velocity-row-outline" data-velocity-row="-1">
        {{#each velocityWords.bottom}}<span>{{this}}</span><i>{{{icon "shield-check" "size-6"}}}</i>{{/each}}
        {{#each velocityWords.bottom}}<span>{{this}}</span><i>{{{icon "shield-check" "size-6"}}}</i>{{/each}}
        {{#each velocityWords.bottom}}<span>{{this}}</span><i>{{{icon "shield-check" "size-6"}}}</i>{{/each}}
    </div>
</div>
