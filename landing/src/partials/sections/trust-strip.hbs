<div class="trust-strip" data-trust-strip aria-label="What Resolvr offers">
    <ul class="trust-track">
        {{#each trustStrip}}<li>{{{icon icon "size-4"}}}<span>{{label}}</span></li>{{/each}}
    </ul>
    <ul class="trust-track" aria-hidden="true">
        {{#each trustStrip}}<li>{{{icon icon "size-4"}}}<span>{{label}}</span></li>{{/each}}
    </ul>
</div>
