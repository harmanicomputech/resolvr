<section id="security" class="security-wrap" aria-labelledby="security-title">
<div class="security dark" data-vault data-scale-in>
    <span class="orb" data-orb="6" data-speed="-0.3" aria-hidden="true"></span>
    <span class="orb" data-orb="7" data-speed="0.3" aria-hidden="true"></span>
    <div class="security-inner">
    <div class="section-head">
        <p class="eyebrow">Security and privacy</p>
        <h2 id="security-title" class="section-title">Everything you need. <span class="muted">Nothing they can touch.</span></h2>
        <p class="section-lead">Built for people who might be watched. Here is exactly what protects your record.</p>
    </div>

    <ul class="icon-cards" data-cols="3" data-stagger>
        {{#each securityCards}}
        <li class="icon-card">
            <span class="icon-badge">{{{icon icon "size-5"}}}</span>
            <h3>{{title}}</h3>
            <p>{{body}}</p>
        </li>
        {{/each}}
    </ul>

    <div class="see-grid">
        <div class="see-col">
            <h3><span class="icon-badge" data-tone="neutral">{{{icon "eye" "size-4"}}}</span> What we can see</h3>
            <ul>
                {{#each canSee}}<li>{{{icon "dot" "size-4"}}}<span>{{this}}</span></li>{{/each}}
            </ul>
        </div>
        <div class="see-col" data-tone="cannot">
            <h3><span class="icon-badge">{{{icon "eye-off" "size-4"}}}</span> What we can't see</h3>
            <ul>
                {{#each cannotSee}}<li>{{{icon "check" "size-4"}}}<span>{{this}}</span></li>{{/each}}
            </ul>
        </div>
    </div>
    </div>
</div>
</section>
