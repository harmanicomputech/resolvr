<section id="security" class="section security" data-security aria-labelledby="security-title">
    <div class="section-head">
        <p class="eyebrow">Security and privacy</p>
        <h2 id="security-title" class="section-title">Everything you need. <em>Nothing they can touch.</em></h2>
        <p class="section-lead">Built for people who might be watched. Here is exactly what protects your record.</p>
    </div>

    <div class="security-stage">
        <div class="shield" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="shield-svg">
                <defs>
                    <linearGradient id="ring-grad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="var(--aurora-1)" />
                        <stop offset="50%" stop-color="var(--aurora-2)" />
                        <stop offset="100%" stop-color="var(--aurora-3)" />
                    </linearGradient>
                </defs>
                <g class="shield-ring" data-ring="1"><circle
                        cx="100"
                        cy="100"
                        r="92"
                        pathLength="100"
                        stroke-dasharray="18 4"
                    /></g>
                <g class="shield-ring" data-ring="2"><circle
                        cx="100"
                        cy="100"
                        r="76"
                        pathLength="100"
                        stroke-dasharray="30 6 8 6"
                    /></g>
                <g class="shield-ring" data-ring="3"><circle
                        cx="100"
                        cy="100"
                        r="60"
                        pathLength="100"
                        stroke-dasharray="44 6"
                    /></g>
                <g class="shield-core">
                    <circle cx="100" cy="100" r="42" />
                    <g
                        transform="translate(82 80) scale(1.5)"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="18" height="11" x="3" y="11" rx="2" />
                        <path class="shield-shackle" d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </g>
                </g>
            </svg>
        </div>

        <ul class="security-cards">
            {{#each securityCards}}
                <li class="glass security-card" data-reveal>
                    <span class="security-icon">{{{icon icon 'size-5'}}}</span>
                    <h3>{{title}}</h3>
                    <p>{{body}}</p>
                </li>
            {{/each}}
        </ul>
    </div>

    <div class="see-grid" data-reveal>
        <div class="card see-col">
            <h3>{{{icon 'eye' 'size-5'}}} What we can see</h3>
            <ul>
                {{#each canSee}}<li>{{this}}</li>{{/each}}
            </ul>
        </div>
        <div class="card see-col" data-tone="cannot">
            <h3>{{{icon 'eye-off' 'size-5'}}} What we can't see</h3>
            <ul>
                {{#each cannotSee}}<li>{{this}}</li>{{/each}}
            </ul>
        </div>
    </div>
</section>