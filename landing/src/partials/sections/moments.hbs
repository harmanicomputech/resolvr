<section class="section split" aria-labelledby="moments-title">
    <div class="split-media" data-reveal>
        <div class="photo split-photo">
            {{{photo "team-meeting" sizes="(min-width: 64rem) 34rem, 92vw"}}}
        </div>
        <div class="split-badge">
            <span class="icon-badge">{{{icon "lock-keyhole" "size-4"}}}</span>
            <span><strong>INC-001</strong> · timestamp locked</span>
        </div>
    </div>
    <div class="split-copy">
        <p class="eyebrow">Moments that matter</p>
        <h2 id="moments-title" class="section-title">It rarely happens <span class="muted">all at once.</span></h2>
        <p class="section-lead">Small moments are easy to dismiss one at a time. Written down the same day, together they tell the real story.</p>
        <ul class="moment-list">
            {{#each moments}}
            <li data-reveal>
                <span class="icon-badge">{{{icon icon "size-4"}}}</span>
                <div>
                    <h3>{{title}}</h3>
                    <p>{{body}}</p>
                </div>
            </li>
            {{/each}}
        </ul>
    </div>
</section>
