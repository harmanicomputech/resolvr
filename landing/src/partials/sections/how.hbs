<section id="how-it-works" class="section how" aria-labelledby="how-title">
    <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="section-title">Four steps. <span class="muted">About a minute each.</span></h2>
    </div>
    <div class="steps-wrap">
        <span class="steps-line" aria-hidden="true"><span data-draw></span></span>
        <ol class="steps" data-stagger>
        {{#each steps}}
        <li class="step">
            <div class="step-top">
                <span class="icon-badge" data-size="lg">{{{icon icon "size-5"}}}</span>
                <span class="step-num mono" aria-hidden="true">{{pad @index}}</span>
            </div>
            <h3>{{title}}</h3>
            <p>{{body}}</p>
        </li>
        {{/each}}
    </ol>
    </div>
</section>
