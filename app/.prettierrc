{
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 4,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "resources/css/app.css",
    "tailwindFunctions": ["cn", "cva"],
    "overrides": [{ "files": ["*.json", "*.yml"], "options": { "tabWidth": 2 } }]
}
