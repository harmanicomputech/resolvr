{
  "id": "/",
  "name": "Resolvr",
  "short_name": "Resolvr",
  "description": "A private, encrypted record of what happens at work. Not legal advice.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f5f0",
  "theme_color": "#f7f5f0",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/resolvr-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/resolvr-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/resolvr-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log incident",
      "short_name": "Log",
      "url": "/log",
      "icons": [
        {
          "src": "/icons/resolvr-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Quick capture",
      "short_name": "Capture",
      "url": "/capture",
      "icons": [
        {
          "src": "/icons/resolvr-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "audio/*"
          ]
        }
      ]
    }
  }
}
