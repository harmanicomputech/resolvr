APP_NAME=Resolvr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resolvr
DB_USERNAME=resolvr
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Local default writes mail to the log; production uses SMTP (see docs/DEPLOY.md).
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.resolvrapp.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="resolvrapp@resolvrapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origins allowed to call the public API (comma-separated). Landing site only.
CORS_ALLOWED_ORIGINS=https://resolvrapp.com

# Server-side only. Never expose to the browser.
ANTHROPIC_API_KEY=

# Encrypted backups (ciphertext only). Defaults: storage/app/backups, 250 MB each, 20 GB in total, 4 MB chunks.
# BACKUP_PATH=
# BACKUP_MAX_BYTES=262144000
# BACKUP_TOTAL_BYTES=21474836480
# BACKUP_CHUNK_BYTES=4194304

# Web push reminders: generate with `php artisan resolvr:vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:resolvrapp@resolvrapp.com

VITE_APP_NAME="${APP_NAME}"
